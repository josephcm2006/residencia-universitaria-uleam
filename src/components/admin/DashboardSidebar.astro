---
// ========================================================================================
// SISTEMA DE GESTIÓN DE RESIDENCIA UNIVERSITARIA - ULEAM
// ARCHIVO: src/components/admin/DashboardSidebar.astro
// ========================================================================================
//
// FUNCIONAMIENTO GENERAL:
// Este componente representa la barra lateral de navegación (Sidebar) de la consola administrativa.
// Permite al personal de Bienestar Estudiantil alternar entre las 4 vistas principales:
// 1. Postulaciones (con badge numérico de solicitudes pendientes).
// 2. Habitaciones (con contador de dormitorios totales).
// 3. Residentes (con contador de estudiantes admitidos con plaza activa).
// 4. Reportes & Cupos (con indicador porcentual de ocupación).
//
// PROPS RECIBIDAS:
// * pendientes {number}: Cantidad de solicitudes por revisar.
// * totalHabitaciones {number}: Número total de habitaciones registradas.
// * totalResidentes {number}: Número de estudiantes admitidos como residentes.
// * porcentajeOcupacion {number}: Porcentaje de ocupación habitacional.
// * activeAdmin {Object}: Datos del administrador en sesión (nombreCompleto, cargo, iniciales).
// ========================================================================================

export interface Props {
  pendientes: number;
  totalHabitaciones: number;
  totalResidentes: number;
  porcentajeOcupacion: number;
  activeAdmin: {
    nombreCompleto: string;
    cargo?: string;
    rol?: string;
    iniciales: string;
  };
}

const {
  pendientes = 0,
  totalHabitaciones = 0,
  totalResidentes = 0,
  porcentajeOcupacion = 0,
  activeAdmin = {
    nombreCompleto: 'Administrador ULEAM',
    cargo: 'Coordinador de Residencias',
    iniciales: 'AD'
  }
} = Astro.props;
---

<aside class="admin-sidebar">
  <div>
    <!-- Cabecera del Sidebar con Logotipo Institucional -->
    <div class="sidebar-header">
      <img src="/assets/icons/logo-uleeam-4x4-removebg-preview.svg" alt="ULEAM Logo" />
      <div class="sidebar-brand-text">
        <h3>Residencia ULEAM</h3>
        <p>Panel de Administración</p>
      </div>
    </div>

    <!-- Navegación por pestañas -->
    <nav class="sidebar-nav">
      <span class="sidebar-nav-title">Gestión Principal</span>

      <!-- Pestaña 1: Postulaciones -->
      <button type="button" class="nav-item-btn active" id="tab-btn-postulaciones" data-target-view="view-postulaciones">
        <span class="nav-label">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          Postulaciones
        </span>
        <span class="nav-badge" id="sidebar-badge-pendientes">{pendientes}</span>
      </button>

      <!-- Pestaña 2: Habitaciones -->
      <button type="button" class="nav-item-btn" id="tab-btn-habitaciones" data-target-view="view-habitaciones">
        <span class="nav-label">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <line x1="9" y1="6" x2="9.01" y2="6"></line>
            <line x1="15" y1="6" x2="15.01" y2="6"></line>
            <line x1="9" y1="10" x2="9.01" y2="10"></line>
            <line x1="15" y1="10" x2="15.01" y2="10"></line>
            <line x1="9" y1="14" x2="9.01" y2="14"></line>
            <line x1="15" y1="14" x2="15.01" y2="14"></line>
            <line x1="9" y1="18" x2="15" y2="18"></line>
          </svg>
          Habitaciones
        </span>
        <span class="nav-badge">{totalHabitaciones}</span>
      </button>

      <span class="sidebar-nav-title" style="margin-top: 14px;">Administración</span>

      <!-- Pestaña 3: Residentes Oficiales -->
      <button type="button" class="nav-item-btn" id="tab-btn-estudiantes" data-target-view="view-estudiantes">
        <span class="nav-label">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Residentes
        </span>
        <span class="nav-badge" id="sidebar-badge-residentes">{totalResidentes}</span>
      </button>

      <!-- Pestaña 4: Reportes & Ocupación -->
      <button type="button" class="nav-item-btn" id="tab-btn-reportes" data-target-view="view-reportes">
        <span class="nav-label">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          Reportes & Cupos
        </span>
        <span class="nav-badge">{porcentajeOcupacion}%</span>
      </button>
    </nav>
  </div>

  <!-- Perfil de Administrador en la parte inferior del Sidebar -->
  <div class="sidebar-footer">
    <div class="admin-card">
      <div class="admin-avatar">{activeAdmin.iniciales}</div>
      <div class="admin-info">
        <strong>{activeAdmin.nombreCompleto}</strong>
        <span>{activeAdmin.cargo || activeAdmin.rol}</span>
      </div>
    </div>
  </div>
</aside>
