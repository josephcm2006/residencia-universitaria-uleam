---
// ========================================================================================
// SISTEMA DE GESTIÓN DE RESIDENCIA UNIVERSITARIA - ULEAM
// ARCHIVO: src/components/admin/VistaHabitaciones.astro
// ========================================================================================
//
// FUNCIONAMIENTO GENERAL:
// Este componente presenta el catálogo visual de todas las habitaciones de la residencia.
// Muestra para cada dormitorio su capacidad física, porcentaje de ocupación, estado
// (Disponible u Ocupada) y el listado de estudiantes que la habitan.
//
// PROPS RECIBIDAS:
// * habitaciones {Array<Object>}: Lista de habitaciones sincronizadas.
// * habDisponibles {number}: Cantidad de dormitorios que tienen al menos una vacante disponible.
// ========================================================================================

export interface Props {
  habitaciones: Array<any>;
  habDisponibles: number;
}

const {
  habitaciones = [],
  habDisponibles = 0
} = Astro.props;
---

<main class="admin-content-view" id="view-habitaciones" style="display: none;">
  <div class="view-header">
    <div>
      <h1>Catálogo de Habitaciones y Ocupación</h1>
      <p>Consulta la ocupación y disponibilidad en tiempo real sincronizada con las admisiones aprobadas.</p>
    </div>
    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; background: #F3F4F6; border: 1px solid #D1D5DB; padding: 6px 12px; border-radius: 0; display: inline-flex; align-items: center; gap: 6px;">
      <span style="width: 6px; height: 6px; background-color: #059669; display: inline-block;"></span> {habDisponibles} Habitaciones Disponibles
    </span>
  </div>

  <!-- Grid de Habitaciones -->
  <div class="rooms-grid">
    {habitaciones.map((hab) => (
      <div class="room-card-admin">
        <div class="room-thumb-wrapper">
          <img src={hab.imagen} alt={`Habitación ${hab.numero}`} />
          <span class={`room-status-pill ${hab.estado.toLowerCase()}`}>{hab.estado}</span>
        </div>
        <div class="room-card-content">
          <div>
            <h3>
              <span>Habitación {hab.numero}</span>
              <span style="font-size: 13px; color: #64748B;">{hab.tipo}</span>
            </h3>
            <p class="room-building">{hab.edificio} · {hab.piso}</p>

            <div class="room-amenities">
              {hab.amenidades.slice(0, 3).map((am) => (
                <span class="amenity-chip">{am}</span>
              ))}
            </div>
          </div>

          <div class="room-capacity-track">
            <div style="display: flex; justify-content: space-between; font-weight: 600;">
              <span>Ocupación: {hab.ocupantesActuales}/{hab.capacidad} camas</span>
              <span>{Math.round((hab.ocupantesActuales / hab.capacidad) * 100)}%</span>
            </div>
            <div class="cap-bar">
              <div class="cap-fill" style={`width: ${(hab.ocupantesActuales / hab.capacidad) * 100}%`}></div>
            </div>
          </div>

          <!-- Lista de Residentes asignados en esta habitación -->
          <div style="margin-top: 12px; padding-top: 10px; border-top: 1px solid #E2E8F0; font-size: 12px;">
            <span style="font-weight: 700; color: #475569; display: block; margin-bottom: 4px; font-size: 11px; text-transform: uppercase;">
              Ocupantes Asignados:
            </span>
            {hab.residentes && hab.residentes.length > 0 ? (
              <ul style="margin: 0; padding-left: 16px; color: #0F172A; font-weight: 600;">
                {hab.residentes.map((res) => (
                  <li>{res.nombreCompleto || res.nombre} ({res.cedula})</li>
                ))}
              </ul>
            ) : (
              <span style="color: #94A3B8; font-style: italic;">Sin ocupantes asignados (Vacante disponible)</span>
            )}
          </div>

          <!-- Botón de Gestión Directa y Asignación de Postulantes -->
          <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid #E5E7EB;">
            <button
              type="button"
              class="btn-manage-room"
              data-room-id={hab.id}
              style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #111827; color: #FFFFFF; border: 1px solid #111827; padding: 10px 14px; border-radius: 0; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: background-color 0.15s ease;"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="11" cy="7" r="4"></circle>
                <line x1="19" y1="8" x2="19" y2="14"></line>
                <line x1="22" y1="11" x2="16" y2="11"></line>
              </svg>
              <span>Gestionar y Asignar Postulante</span>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
</main>
