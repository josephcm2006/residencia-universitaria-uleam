---
// src/components/admin/RoomManageModal.astro
// ========================================================================================
// SISTEMA DE GESTIÓN DE RESIDENCIA UNIVERSITARIA - ULEAM
// ARCHIVO: src/components/admin/RoomManageModal.astro
// ========================================================================================
// FUNCIONAMIENTO:
// Modal interactivo para que el administrador gestione directamente cualquier habitación:
// 1. Ver detalles de capacidad, género normativo y ocupación actual.
// 2. Revisar ocupantes actuales con opción de liberar cupo.
// 3. Asignar nuevos postulantes con Asistente de Compatibilidad en tiempo real.
// ========================================================================================
---

<div id="room-manage-modal" class="admin-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(5px); z-index: 999999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; width: 100%; max-width: 640px; border-radius: 0; box-shadow: 0 20px 40px rgba(0,0,0,0.4); border: 1px solid #111827; overflow: hidden; display: flex; flex-direction: column; max-height: 90vh;">
    
    <!-- Header del Modal -->
    <div style="background-color: #0F172A; color: #FFFFFF; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1E293B;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 36px; height: 36px; border-radius: 0; background: #1F2937; color: #F3F4F6; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <div>
          <h3 id="rm-title-numero" style="font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0;">Gestión de Habitación</h3>
          <p id="rm-title-meta" style="font-size: 12.5px; color: #94A3B8; margin: 2px 0 0 0;">Edificio · Piso · Tipo</p>
        </div>
      </div>
      <button type="button" id="btn-close-room-modal" style="background: transparent; border: none; color: #94A3B8; font-size: 18px; cursor: pointer; padding: 6px; border-radius: 0;">✕</button>
    </div>

    <!-- Cuerpo del Modal con scroll -->
    <div style="padding: 20px 24px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 18px; background-color: #F8FAFC;">
      
      <!-- Ficha de Metadatos de la Habitación -->
      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 0; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <span style="background: #F3F4F6; border: 1px solid #D1D5DB; color: #111827; padding: 4px 10px; border-radius: 0; font-size: 11.5px; font-weight: 600;">
            Género: <strong id="rm-badge-genero">Masculino</strong>
          </span>
          <span style="background: #F3F4F6; border: 1px solid #D1D5DB; color: #111827; padding: 4px 10px; border-radius: 0; font-size: 11.5px; font-weight: 600;">
            Capacidad: <strong id="rm-badge-capacidad">0/2</strong>
          </span>
          <span id="rm-badge-acc-wrapper" style="background: #F3F4F6; border: 1px solid #D1D5DB; color: #111827; padding: 4px 10px; border-radius: 0; font-size: 11.5px; font-weight: 600;">
            Accesibilidad: <strong id="rm-badge-acc">No adaptada</strong>
          </span>
        </div>
        <span id="rm-badge-status-pill" style="padding: 4px 12px; border-radius: 0; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;">Disponible</span>
      </div>

      <!-- SECCIÓN 1: OCUPANTES ACTUALES -->
      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 0; padding: 16px;">
        <span style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.04em; display: block; margin-bottom: 10px;">
          Ocupantes Actuales Asignados
        </span>

        <div id="rm-occupants-list" style="display: flex; flex-direction: column; gap: 8px;">
          <!-- Inyectado dinámicamente -->
        </div>

        <div id="rm-empty-occupants" style="display: none; padding: 16px; text-align: center; color: #64748B; font-size: 12.5px; background: #F9FAFB; border: 1px dashed #D1D5DB; border-radius: 0;">
          Esta habitación no tiene ocupantes asignados actualmente (Vacante 100% libre).
        </div>
      </div>

      <!-- SECCIÓN 2: ASIGNAR NUEVO POSTULANTE -->
      <div id="rm-assign-container" style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 0; padding: 16px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
          <h4 style="font-size: 13.5px; font-weight: 700; color: #111827; margin: 0; display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="11" cy="7" r="4"></circle>
              <line x1="19" y1="8" x2="19" y2="14"></line>
              <line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
            <span>Asignar Postulante a esta Habitación</span>
          </h4>
          <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; background: #FFFFFF; border: 1px solid #D1D5DB; padding: 3px 8px; border-radius: 0;">Asistente Activo</span>
        </div>
        <p style="font-size: 12px; color: #4B5563; margin: 0 0 12px 0;">Selecciona un postulante disponible para evaluar la compatibilidad de convivencia en tiempo real:</p>

        <div id="rm-room-full-warning" style="display: none; padding: 12px 14px; background: #F3F4F6; border: 1px solid #D1D5DB; color: #111827; border-radius: 0; font-size: 12px; font-weight: 600;">
          Capacidad máxima alcanzada. Para ingresar a otro estudiante, primero debes liberar un cupo de los ocupantes actuales.
        </div>

        <div id="rm-assign-controls">
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 6px;">
            Postulante o Estudiante Disponible:
          </label>
          <select id="rm-select-student" style="width: 100%; padding: 10px; font-size: 12.5px; font-weight: 600; border: 1px solid #D1D5DB; border-radius: 0; background-color: #FFFFFF; color: #111827; outline: none; margin-bottom: 12px; cursor: pointer;">
            <!-- Inyectado dinámicamente -->
          </select>

          <!-- Caja de Compatibilidad en Vivo -->
          <div id="rm-compat-feedback" style="padding: 12px 14px; border-radius: 0; font-size: 12px; line-height: 1.45; border: 1px solid #E5E7EB; background-color: #FFFFFF; margin-bottom: 12px;">
            <span style="color: #64748B;">Selecciona un postulante para calcular el semáforo de compatibilidad.</span>
          </div>

          <button type="button" id="btn-rm-assign-confirm" style="width: 100%; background-color: #111827; color: #FFFFFF; border: 1px solid #111827; padding: 10px 16px; border-radius: 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: background 0.15s ease;">
            Confirmar y Asignar a la Habitación
          </button>
        </div>
      </div>

    </div>

    <!-- Footer del Modal -->
    <div style="padding: 12px 24px; background-color: #FFFFFF; border-top: 1px solid #E2E8F0; text-align: right;">
      <button type="button" id="btn-rm-modal-close" style="background: #FFFFFF; border: 1px solid #D1D5DB; color: #374151; padding: 8px 18px; border-radius: 0; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;">
        Cerrar Ventana
      </button>
    </div>

  </div>
</div>
