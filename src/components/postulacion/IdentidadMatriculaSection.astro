---
// src/components/postulacion/IdentidadMatriculaSection.astro
---

<section class="form-section">
  <div class="section-head">
    <div class="icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="0"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="7" y1="16" x2="12" y2="16"/></svg>
    </div>
    <div>
      <h3>Identidad y matrícula</h3>
      <p>Adjunta tus documentos en formato legible por ambas caras.</p>
    </div>
  </div>

  <div class="file-list">
    <!-- Archivo 1: Cédula -->
    <div class="file-row" data-file-card="cedula">
      <div class="file-info">
        <div class="icon-doc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6v20h12V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div>
          <strong>Cédula de identidad (ambas caras)</strong>
          <span class="file-desc" id="desc-cedula">Formatos permitidos: PDF, JPG, PNG (Máx 10 MB)</span>
        </div>
      </div>
      <div class="file-actions">
        <span class="file-status" id="status-cedula">Sin archivo</span>
        <label for="input-file-cedula" class="file-upload-btn">
          📁 Seleccionar archivo
        </label>
        <input type="file" id="input-file-cedula" name="file_cedula" accept=".pdf,.jpg,.jpeg,.png" class="file-hidden-input" data-doc-type="Cédula de identidad" />
      </div>
    </div>

    <!-- Archivo 2: Matrícula -->
    <div class="file-row" data-file-card="matricula">
      <div class="file-info">
        <div class="icon-doc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6v20h12V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div>
          <strong>Certificado de matrícula vigente (Periodo 2026-2)</strong>
          <span class="file-desc" id="desc-matricula">Certificado descargado del sistema académico ULEAM</span>
        </div>
      </div>
      <div class="file-actions">
        <span class="file-status" id="status-matricula">Sin archivo</span>
        <label for="input-file-matricula" class="file-upload-btn">
          📁 Seleccionar archivo
        </label>
        <input type="file" id="input-file-matricula" name="file_matricula" accept=".pdf,.jpg,.jpeg,.png" class="file-hidden-input" data-doc-type="Certificado de matrícula" />
      </div>
    </div>
  </div>
</section>
