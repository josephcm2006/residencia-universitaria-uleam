---
// src/components/postulacion/JsonPreviewModal.astro
---

<!-- Modal para ver el JSON generado -->
<div id="json-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
  <div style="background: #ffffff; max-width: 600px; width: 100%; max-height: 85vh; border-radius: 4px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
    <div style="padding: 16px 20px; background: #18181B; color: #ffffff; display: flex; justify-content: space-between; align-items: center;">
      <strong style="font-size: 14px;">Datos de la Postulación (Estructura JSON)</strong>
      <button type="button" id="btn-close-json-modal" style="background: transparent; border: none; color: #ffffff; font-size: 18px; cursor: pointer;">✕</button>
    </div>
    <div style="padding: 20px; overflow-y: auto; flex: 1;">
      <p style="font-size: 12px; color: #666; margin-bottom: 12px;">Esta es la información que se recolecta de tus campos escritos y archivos seleccionados para ser guardada:</p>
      <pre id="json-preview" style="background: #F4F4F5; padding: 14px; font-size: 12px; font-family: monospace; white-space: pre-wrap; word-break: break-all; border: 1px solid #E4E4E7;"></pre>
    </div>
    <div style="padding: 14px 20px; background: #FBFBF9; border-top: 1px solid #E4E4E7; text-align: right;">
      <button type="button" id="btn-modal-ok" class="btn-primary" style="padding: 8px 18px; font-size: 12px;">Cerrar</button>
    </div>
  </div>
</div>
