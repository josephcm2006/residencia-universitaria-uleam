---
// src/components/postulacion/ReferenciasSection.astro
---

<section class="form-section">
  <div class="section-head">
    <div class="icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    </div>
    <div>
      <h3>Referencias y contacto de emergencia</h3>
      <p>Ingresa dos referencias de contacto con información verificable.</p>
    </div>
  </div>

  <!-- Referencia 1 -->
  <div style="margin-bottom: 20px;">
    <strong style="display:block; font-size:12px; font-weight:700; color:var(--gris-oscuro); margin-bottom:10px; text-transform:uppercase;">
      Referencia 1 (Familiar o Contacto de Emergencia)
    </strong>
    <div class="grid-3">
      <div class="field-group">
        <label>Nombre y apellido</label>
        <input type="text" name="ref1_nombre" placeholder="Ej. Rosa Mendoza" />
      </div>
      <div class="field-group">
        <label>Parentesco / Relación</label>
        <input type="text" name="ref1_parentesco" placeholder="Ej. Madre / Padre" />
      </div>
      <div class="field-group">
        <label>Teléfono de contacto</label>
        <input type="tel" name="ref1_telefono" placeholder="Ej. 098 123 4567" />
      </div>
    </div>
  </div>

  <!-- Referencia 2 -->
  <div style="margin-bottom: 20px;">
    <strong style="display:block; font-size:12px; font-weight:700; color:var(--gris-oscuro); margin-bottom:10px; text-transform:uppercase;">
      Referencia 2 (Personal o Académica)
    </strong>
    <div class="grid-3">
      <div class="field-group">
        <label>Nombre y apellido</label>
        <input type="text" name="ref2_nombre" placeholder="Ej. Ing. Carlos Zambrano" />
      </div>
      <div class="field-group">
        <label>Vínculo o Institución</label>
        <input type="text" name="ref2_parentesco" placeholder="Ej. Tutor / Docente ULEAM" />
      </div>
      <div class="field-group">
        <label>Teléfono de contacto</label>
        <input type="tel" name="ref2_telefono" placeholder="Ej. 099 765 4321" />
      </div>
    </div>
  </div>

  <div class="file-list">
    <div class="file-row" data-file-card="carta-referencia">
      <div class="file-info">
        <div class="icon-doc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6v20h12V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div>
          <strong>Carta de recomendación o referencia personal</strong>
          <span class="file-desc" id="desc-carta-referencia">Documento firmado por el contacto de referencia</span>
        </div>
      </div>
      <div class="file-actions">
        <span class="file-status" id="status-carta-referencia">Sin archivo</span>
        <label for="input-file-carta-referencia" class="file-upload-btn">
          📁 Seleccionar archivo
        </label>
        <input type="file" id="input-file-carta-referencia" name="file_referencia" accept=".pdf,.jpg,.jpeg,.png" class="file-hidden-input" data-doc-type="Carta de referencia" />
      </div>
    </div>
  </div>
</section>
