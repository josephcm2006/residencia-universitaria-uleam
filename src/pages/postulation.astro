---
// src/pages/postulation.astro
import fs from 'node:fs/promises';
import path from 'node:path';
import '../styles/postulation.css';
import '../styles/css-responsive/postulation.responsive.css';
import usuarios from '../data/usuarios.json';
import fallbackPostulaciones from '../data/postulaciones.json';

// Componentes Globales
import HelpModal from '../components/shared/HelpModal.jsx';
import ExitConfirmModal from '../components/shared/ExitConfirmModal.jsx';
import PostulationErrorModal from '../components/postulacion/PostulationErrorModal.jsx';
import AnimacionPostulacion from '../components/postulacion/AnimacionPostulacion.jsx';
import Footer from '../components/shared/Footer.astro';

// --formulario components postulacion
import DatosPersonalesSection from '../components/postulacion/DatosPersonalesSection.astro';
import IdentidadMatriculaSection from '../components/postulacion/IdentidadMatriculaSection.astro';
import ComposicionHogarSection from '../components/postulacion/ComposicionHogarSection.astro';
import ReferenciasSection from '../components/postulacion/ReferenciasSection.astro';
import SituacionEconomicaSection from '../components/postulacion/SituacionEconomicaSection.astro';
import AccesibilidadSection from '../components/postulacion/AccesibilidadSection.astro';
import HabitacionPreferenciaSection from '../components/postulacion/HabitacionPreferenciaSection.astro';
import ConsentimientoSection from '../components/postulacion/ConsentimientoSection.astro';
import EtapasPostulacionSection from '../components/postulacion/EtapasPostulacionSection.astro';
import JsonPreviewModal from '../components/postulacion/JsonPreviewModal.astro';

// Indicador para el runtime de Astro para ejecución dinámica bajo demanda (SSR en servidor)
export const prerender = false;

// ----------------------------------------------------------------------------------------
// 1. GESTIÓN DE SESIÓN Y AUTENTICACIÓN DINÁMICA
// ----------------------------------------------------------------------------------------

// // Variable 'sessionCookie': Almacena el valor de la cookie HTTP-Only 'uleam_session'
const sessionCookie = Astro.cookies.get('uleam_session')?.value;

// // Variable 'userSession': Objeto con las credenciales decodificadas de la sesión activa
let userSession = null;
if (sessionCookie) {
  try {
    userSession = JSON.parse(sessionCookie);
  } catch (e) {
    userSession = null;
  }
}

// // Si hay sesión activa, se sincroniza con usuarios.json. Si no hay sesión (pruebas directas en navegador),
// // se toma el estudiante postulante de usuarios.json sin datos quemados para permitir previsualizar el formulario.
const estudiantePostulante = usuarios.find((u) => u.aceptado === 0) || usuarios[0];
const usuarioEncontrado = userSession
  ? (usuarios.find((u) => u.email?.toLowerCase().trim() === userSession.email?.toLowerCase().trim() || u.cedula === userSession.cedula) || userSession)
  : estudiantePostulante;

const activeUser = usuarioEncontrado ? { ...usuarioEncontrado, ...(userSession || {}) } : estudiantePostulante;

// // Regla de Negocio: Si un estudiante con sesión activa ya tiene calidad de aceptado (1), redirigir a su Dashboard
if (userSession && activeUser.aceptado === 1) {
  return Astro.redirect('/residente-dashboard');
}

// // Extracción 100% dinámica de las propiedades del estudiante autenticado (sin datos quemados)
const nombreCompleto = activeUser.nombreCompleto || activeUser.nombre || "Estudiante ULEAM";
const nombreCorto = activeUser.nombre || (nombreCompleto ? nombreCompleto.split(' ')[0] : "Estudiante");
const rol = activeUser.rol || "Estudiante";
const correo = activeUser.email || activeUser.correo || "";
const cedula = activeUser.cedula || "";
const carrera = activeUser.carrera 
  ? `${activeUser.carrera}${activeUser.periodo ? ` · ${activeUser.periodo}` : ''}` 
  : "Carrera Universitaria";

// // Cálculo dinámico de iniciales para el avatar del estudiante
const partes = nombreCompleto.split(' ').filter(Boolean);
const iniciales = partes.length >= 2
  ? (partes[0].charAt(0) + partes[1].charAt(0)).toUpperCase()
  : (partes[0]?.charAt(0) || 'U').toUpperCase();

// // Objeto consolidado del estudiante para inyectar en las secciones del formulario
const estudiante = {
  nombre: nombreCompleto,
  nombreCorto: nombreCorto,
  rol: rol,
  correo: correo,
  cedula: cedula,
  carrera: carrera,
  iniciales: iniciales
};

// 2. Cargar lista de postulaciones para validar duplicados
let listaPostulaciones = fallbackPostulaciones;
try {
  const filePath = path.resolve('src/data/postulaciones.json');
  const rawData = await fs.readFile(filePath, 'utf-8');
  listaPostulaciones = JSON.parse(rawData);
} catch (e) {
  listaPostulaciones = fallbackPostulaciones;
}

const postExistente = listaPostulaciones.find((p) => p.estudiante?.cedula === cedula);

// Si el estudiante ya tiene una postulación registrada, redirigir inmediatamente a /postulado
// sin mostrar el formulario ni avisos verdes en la cabecera
if (postExistente) {
  return Astro.redirect(`/postulado?id=${postExistente.id}`);
}
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Postulación a Residencia - ULEAM</title>
  </head>
  <body>

    <!-- 1. HEADER SUPERIOR -->
    <header class="topbar">
      <div class="header-brand">
        <a href="/portal-init" style="display: flex; align-items: center; gap: 16px; text-decoration: none; color: inherit;">
          <img src="/assets/icons/logo-uleeam-4x4-removebg-preview.svg" alt="Logo ULEAM" />
          <div>
            <h4>Residencia Universitaria</h4>
            <p>Universidad Laica Eloy Alfaro de Manabí</p>
          </div>
        </a>
        <div class="divider"></div>
        <span class="portal-tag">Postulación 2026-2</span>
      </div>

      <div class="header-user">
        <HelpModal client:load className="help-link" />
        <div class="divider"></div>
        <a href="/portal-init" class="help-link">← Volver al portal</a>
        <div class="divider"></div>
        <div class="user-profile">
          <div class="avatar">{estudiante.iniciales}</div>
          <div class="user-text">
            <strong>{estudiante.nombreCorto}</strong>
            <span>{estudiante.rol} · {estudiante.cedula}</span>
          </div>
        </div>
        <div class="divider"></div>
        <ExitConfirmModal
          client:load
          buttonText="↪ Salir"
          title="¿Deseas salir del formulario?"
          message="Tu progreso se guarda como borrador. Puedes regresar en cualquier momento para continuar o adjuntar más documentos."
          confirmText="Sí, salir al portal"
          redirectUrl="/portal-init"
          className="help-link"
        />
      </div>
    </header>

    <!-- Modales React con Desenfoque de Fondo (blur) -->
    <PostulationErrorModal client:load />
    <AnimacionPostulacion client:load />

    <!-- 2. BANNER SUPERIOR -->
    <section class="hero-banner">
      <div class="hero-overlay">
        <span class="hero-kicker">CONVOCATORIA DE RESIDENCIA ESTUDIANTIL</span>
        <h1>Completa tu postulación</h1>
        <p>Completa la información requerida y adjunta la documentación solicitada. Tu progreso se guarda automáticamente.</p>
      </div>
    </section>

    <!-- 3. BARRA DE PROGRESO -->
    <section class="progress-strip">
      <div class="progress-container">
        <div class="progress-left">
          <strong>Progreso general</strong>
          <div class="progress-bar-track">
            <div id="progress-fill" class="progress-bar-fill" style="width: 20%;"></div>
          </div>
          <span id="progress-text" class="progress-percent">20%</span>
        </div>
        <div class="deadline-pill">
          <span>Fecha límite: 30 oct 2026 · 17:00</span>
        </div>
      </div>
    </section>

    <!-- Notificación flotante de guardado -->
    <div id="save-toast" style="display: none; position: fixed; bottom: 24px; right: 24px; background: #18181B; color: #ffffff; padding: 14px 20px; font-size: 13px; font-weight: 600; box-shadow: 0 10px 25px rgba(0,0,0,0.3); z-index: 99999; border-left: 4px solid #1F7A4C; align-items: center; gap: 10px;">
      <span id="toast-message">Borrador guardado correctamente.</span>
    </div>

    <!-- 4. CONTENEDOR DEL FORMULARIO COMPLETO -->
    <main class="form-wrapper">
      


      <div class="form-header-row">
        <div>
          <h2>Formulario de solicitud de residencia</h2>
          <p>Aceptamos archivos en PDF, JPG o PNG de hasta 10 MB. Completa los campos correspondientes a tu situación.</p>
        </div>
        <button type="button" id="btn-save-draft" class="btn-outline">Guardar borrador</button>
      </div>

      <form
        id="form-postulacion"
        novalidate
        data-postulaciones-existentes={JSON.stringify(listaPostulaciones.map((p) => ({ cedula: p.estudiante?.cedula, correo: p.estudiante?.correo, id: p.id, estado: p.estado })))}
      >
        <DatosPersonalesSection estudiante={estudiante} />
        <IdentidadMatriculaSection />
        <ComposicionHogarSection />
        <ReferenciasSection />
        <SituacionEconomicaSection />
        <AccesibilidadSection />
        <HabitacionPreferenciaSection />
        <ConsentimientoSection />
        <EtapasPostulacionSection />
      </form>
    </main>

    <!-- Modal Visor JSON -->
    <JsonPreviewModal />

    <!-- Footer Institucional Unificado -->
    <Footer />

    <!-- Lógica Cliente y Validaciones del Formulario de Postulación -->
    <script src="../scripts/postulacion/postulacion.js"></script>
  </body>
</html>
