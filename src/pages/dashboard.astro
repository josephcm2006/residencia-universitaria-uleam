---
// ========================================================================================
// SISTEMA DE GESTIÓN DE RESIDENCIA UNIVERSITARIA - ULEAM
// ARCHIVO: src/pages/dashboard.astro
// ========================================================================================
//
// FUNCIONAMIENTO GENERAL:
// Este archivo actúa como la vista controladora principal de la Consola de Administración.
// Organiza de forma limpia y modular la interfaz gráfica dividiéndola en subcomponentes:
// 1. Sidebar (Menú lateral y perfil de administrador).
// 2. Vista de Postulaciones (KPIs, búsqueda, filtros y tabla de solicitudes).
// 3. Vista de Habitaciones (Inventario de dormitorios y ocupación física).
// 4. Vista de Residentes (Padrón oficial de estudiantes admitidos).
// 5. Vista de Reportes (Estadísticas y balance de cupos por edificio).
// 6. Modales de Inspección de Expediente y Visor de Documentos Digitales.
//
// CARACTERÍSTICAS TÉCNICAS:
// - Arquitectura Frontend Modular: Cada sección reside en su propio componente Astro.
// - Script modular en 'src/scripts/dashboard.js'.
// - Cero redundancia de código y máxima legibilidad para exposiciones y defensas de proyecto.
// ========================================================================================

import '../styles/dashboard.css';
import '../styles/css-responsive/dashboard.responsive.css';
import fs from 'node:fs/promises';
import path from 'node:path';
import administradores from '../data/administradores.json';
import fallbackPostulaciones from '../data/postulaciones.json';
import fallbackHabitaciones from '../data/habitaciones.json';
import fallbackUsuarios from '../data/usuarios.json';

// Componentes Modulares de la Consola
import DashboardSidebar from '../components/admin/DashboardSidebar.astro';
import VistaPostulaciones from '../components/admin/VistaPostulaciones.astro';
import VistaHabitaciones from '../components/admin/VistaHabitaciones.astro';
import VistaResidentes from '../components/admin/VistaResidentes.astro';
import VistaReportes from '../components/admin/VistaReportes.astro';
import ExpedienteModal from '../components/admin/ExpedienteModal.astro';
import RoomManageModal from '../components/admin/RoomManageModal.astro';
import DocViewerModal from '../components/admin/DocViewerModal.astro';

// Componentes Compartidos
import HelpModal from '../components/shared/HelpModal.jsx';
import ExitConfirmModal from '../components/shared/ExitConfirmModal.jsx';
import Footer from '../components/shared/Footer.astro';

export const prerender = false;

// 1. Obtener la sesión activa del administrador
const sessionCookie = Astro.cookies.get('uleam_session')?.value;
let userSession = null;
if (sessionCookie) {
  try {
    userSession = JSON.parse(sessionCookie);
  } catch (e) {
    userSession = null;
  }
}

// 2. Administrador activo con fallback limpio
const defaultAdmin = administradores[0];
const activeAdmin = userSession || defaultAdmin;
const inicialesAdmin = (activeAdmin.nombre?.charAt(0) || 'A') + (activeAdmin.nombreCompleto?.split(' ')[1]?.charAt(0) || 'D');

// 3. Cargar postulaciones desde disco
let postulaciones = fallbackPostulaciones;
try {
  const filePath = path.resolve('src/data/postulaciones.json');
  const rawData = await fs.readFile(filePath, 'utf-8');
  postulaciones = JSON.parse(rawData);
} catch (e) {
  postulaciones = fallbackPostulaciones;
}

// 4. Cargar catálogo de usuarios
let usuarios = fallbackUsuarios;
try {
  const userPath = path.resolve('src/data/usuarios.json');
  const rawUsers = await fs.readFile(userPath, 'utf-8');
  usuarios = JSON.parse(rawUsers);
} catch (e) {
  usuarios = fallbackUsuarios;
}

// 5. Cargar inventario de habitaciones
let habitaciones = fallbackHabitaciones;
try {
  const habFilePath = path.resolve('src/data/habitaciones.json');
  const rawHabData = await fs.readFile(habFilePath, 'utf-8');
  habitaciones = JSON.parse(rawHabData);
} catch (e) {
  habitaciones = fallbackHabitaciones;
}

// 6. Residentes admitidos y sincronización visual de habitaciones
const residentesAceptados = usuarios.filter((u) => u.aceptado === 1 && u.habitacionId);

const habitacionesSincronizadas = habitaciones.map((hab) => {
  const ocupantes = residentesAceptados.filter((u) => u.habitacionId === hab.id);
  const total = ocupantes.length;
  return {
    ...hab,
    ocupantesActuales: total,
    estado: total >= hab.capacidad ? 'Ocupada' : 'Disponible',
    residentes: ocupantes
  };
});

// 7. Métricas cuantitativas del periodo
const pendientes = postulaciones.filter((p) => p.estado === 'Pendiente').length;
const aprobadas = postulaciones.filter((p) => p.estado === 'Aprobada').length;
const rechazadas = postulaciones.filter((p) => p.estado === 'Rechazada').length;
const habDisponibles = habitacionesSincronizadas.filter((h) => h.estado === 'Disponible').length;

const totalCamas = habitacionesSincronizadas.reduce((sum, h) => sum + h.capacidad, 0);
const camasOcupadas = habitacionesSincronizadas.reduce((sum, h) => sum + h.ocupantesActuales, 0);
const camasLibres = Math.max(0, totalCamas - camasOcupadas);
const porcentajeOcupacion = totalCamas > 0 ? Math.round((camasOcupadas / totalCamas) * 100) : 0;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consola de Administración - Residencias ULEAM</title>
  </head>
  <body>
    <div class="admin-layout">
      <!-- 1. Menú Lateral (Sidebar) Modular -->
      <DashboardSidebar
        pendientes={pendientes}
        totalHabitaciones={habitacionesSincronizadas.length}
        totalResidentes={residentesAceptados.length}
        porcentajeOcupacion={porcentajeOcupacion}
        activeAdmin={{
          nombreCompleto: activeAdmin.nombreCompleto,
          cargo: activeAdmin.cargo || 'Coordinador de Residencias',
          rol: activeAdmin.rol,
          iniciales: inicialesAdmin
        }}
      />

      <!-- 2. Área Principal de Trabajo -->
      <div class="admin-main">
        <!-- Topbar Superior Institucional -->
        <header class="admin-topbar">
          <div class="breadcrumb-nav">
            <span>Consola ULEAM</span>
            <span>&gt;</span>
            <strong id="breadcrumb-title">Gestión de Postulaciones 2026-2</strong>
          </div>

          <div class="topbar-actions">
            <HelpModal client:load buttonText="Soporte" className="help-link" />
            <div style="width: 1px; height: 22px; background-color: #E2E8F0;"></div>
            <ExitConfirmModal
              client:load
              buttonText="Salir"
              title="¿Cerrar sesión de administrador?"
              message="Se cerrará tu sesión de gestión. Deberás ingresar nuevamente con tus credenciales institucionales."
              confirmText="Sí, salir"
              redirectUrl="/api/auth/logout"
            />
          </div>
        </header>

        <!-- Vistas Modulares del Dashboard -->
        <VistaPostulaciones
          postulaciones={postulaciones}
          pendientes={pendientes}
          aprobadas={aprobadas}
          rechazadas={rechazadas}
          habDisponibles={habDisponibles}
        />

        <VistaHabitaciones
          habitaciones={habitacionesSincronizadas}
          habDisponibles={habDisponibles}
        />

        <VistaResidentes
          residentes={residentesAceptados}
        />

        <VistaReportes
          totalCamas={totalCamas}
          camasOcupadas={camasOcupadas}
          camasLibres={camasLibres}
          porcentajeOcupacion={porcentajeOcupacion}
          habitaciones={habitacionesSincronizadas}
        />
      </div>
    </div>

    <!-- Contenedor de Datos de Habitaciones y Postulantes para el Asistente de Compatibilidad -->
    <div id="admin-habitaciones-data" data-habitaciones={JSON.stringify(habitacionesSincronizadas)} style="display: none;"></div>
    <div id="admin-postulantes-data" data-postulantes={JSON.stringify(usuarios.filter((u) => u.aceptado === 0))} style="display: none;"></div>

    <!-- Modales Flotantes de Inspección y Visor -->
    <ExpedienteModal />
    <RoomManageModal />
    <DocViewerModal />

    <!-- Footer Institucional Unificado -->
    <Footer />

    <!-- Script Cliente Modular -->
    <script src="../scripts/dashboard.js"></script>
  </body>
</html>
